rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ----------------------------------------------------------------------
    //  Shared helpers
    // ----------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    // https-only: the app is served over HTTPS, so a plaintext avatar would be
    // blocked as mixed content anyway. Rejecting it here keeps the contract
    // honest and avoids leaking a referrer to an unencrypted host.
    function validPhotoURL(url) {
      return url is string && url.size() <= 512 && url.matches('https://.*');
    }

    // The exact emoji the client offers, written as literal characters so they
    // are byte-identical to REACTION_EMOJIS in src/utils/validation.ts.
    // Firestore Security Rules have NO higher-order `all()`/`exists()` (those
    // are Realtime Database features), so the reaction keys are validated
    // against this allowlist explicitly instead of being iterated.
    function allowedReactionEmojis() {
      return ['👍', '❤️', '😂', '🎉', '🔥'];
    }

    // One emoji entry: must be a list, capped at 50 reactors.
    function validReactionEntry(reactions, emoji) {
      return !(emoji in reactions) || (
        reactions[emoji] is list
        && reactions[emoji].size() <= 50
      );
    }

    // reactions: map of emoji -> list of uids.
    // Caps: only allowlisted emoji keys, at most 50 reactors per emoji, so
    // nobody can balloon a document with an arbitrary payload.
    function validReactions(reactions) {
      return reactions is map
        && reactions.size() <= 5
        && reactions.keys().hasOnly(allowedReactionEmojis())
        && validReactionEntry(reactions, '👍')
        && validReactionEntry(reactions, '❤️')
        && validReactionEntry(reactions, '😂')
        && validReactionEntry(reactions, '🎉')
        && validReactionEntry(reactions, '🔥');
    }

    // replyTo: an immutable quote preview. Absent (null) is allowed.
    function validReplyTo(replyTo) {
      return replyTo == null || (
        replyTo is map
        && replyTo.keys().hasOnly(['id', 'text', 'displayName'])
        && replyTo.id is string
        && replyTo.id.size() > 0
        && replyTo.id.size() <= 200
        && replyTo.text is string
        && replyTo.text.size() > 0
        && replyTo.text.size() <= 1000
        && (replyTo.displayName is string || replyTo.displayName == null)
        && (replyTo.displayName == null || replyTo.displayName.size() <= 100)
      );
    }

    // Core message shape shared by create and update. The authorship and the
    // server-controlled timestamp are checked separately, because their
    // correct value differs between the two operations.
    function validMessageBody(message) {
      return message.keys().hasOnly([
          'text', 'uid', 'displayName', 'photoURL', 'createdAt', 'replyTo', 'reactions'
        ])
        && message.text is string
        && message.text.size() > 0
        && message.text.size() <= 1000
        && message.uid is string
        && (message.displayName is string || message.displayName == null)
        && (message.displayName == null || message.displayName.size() <= 100)
        && (message.photoURL is string || message.photoURL == null)
        && (message.photoURL == null || validPhotoURL(message.photoURL))
        && message.createdAt is timestamp
        && validReplyTo(message.replyTo)
        && validReactions(message.reactions);
    }

    // ----------------------------------------------------------------------
    //  messages
    // ----------------------------------------------------------------------
    match /messages/{messageId} {
      function isAuthor() {
        return signedIn() && resource.data.uid == request.auth.uid;
      }

      // Only authenticated users may read the public chat log.
      allow read: if signedIn();

      // Create: strict schema, you can only post as yourself, the timestamp
      // must come from the server context (prevents client-controlled clocks).
      allow create: if signedIn()
        && validMessageBody(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;

      // Update, path A: the author edits the text of their own message.
      // Every other field (uid, createdAt, displayName, photoURL, replyTo,
      // reactions) must be byte-identical to what is already stored — otherwise
      // an author could rewrite their own display name and impersonate someone.
      function canEditOwnMessage() {
        return signedIn()
          && validMessageBody(request.resource.data)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.displayName == resource.data.displayName
          && request.resource.data.photoURL == resource.data.photoURL
          && request.resource.data.replyTo == resource.data.replyTo
          && request.resource.data.reactions == resource.data.reactions
          && isAuthor();
      }

      // Update, path B: any signed-in user reacts to any message. Only the
      // reactions map may differ; the message content must not change.
      function canOnlyChangeReactions() {
        return signedIn()
          && validMessageBody(request.resource.data)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.text == resource.data.text
          && request.resource.data.displayName == resource.data.displayName
          && request.resource.data.photoURL == resource.data.photoURL
          && request.resource.data.replyTo == resource.data.replyTo;
      }

      allow update: if canEditOwnMessage() || canOnlyChangeReactions();

      // Delete: only the original author.
      allow delete: if isAuthor();
    }

    // ----------------------------------------------------------------------
    //  presence  (online roster)
    // ----------------------------------------------------------------------
    match /presence/{uid} {
      // Any signed-in user may read the roster to show who is online.
      allow read: if signedIn();

      // You may only write your own presence document, with your own uid, and
      // the timestamp must be server-generated.
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'online', 'lastSeen'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 512
        && request.resource.data.online is bool
        && request.resource.data.lastSeen == request.time;

      allow delete: if signedIn() && request.auth.uid == uid;
    }
  }
}
